# Maze Bank Production Environment Configuration
# ⚠️ DO NOT USE REAL CREDENTIALS OR DATA
# This is for temporary educational deployments only

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=maze_bank
DB_USER=postgres
DB_PASSWORD=change_this_password_12345

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Configuration
REACT_APP_API_URL=http://your-domain.com/api

# CORS Configuration
CORS_ORIGIN=http://your-domain.com

# Session Configuration
SESSION_SECRET=change_this_secret_key_12345
SESSION_EXPIRY_HOURS=1

# Basic Auth for Nginx (generate with: htpasswd -c .htpasswd lecturer)
# Default credentials will be set in deployment
NGINX_AUTH_USER=lecturer
NGINX_AUTH_PASSWORD=change_this_password

# Deployment Notes
# 1. Generate htpasswd file: htpasswd -c deployment/.htpasswd lecturer
# 2. Use a non-guessable subdomain or domain name
# 3. Set strong passwords for all services
# 4. Enable HTTPS with valid SSL certificates
# 5. Set up IP whitelisting if possible
# 6. Enable rate limiting on the Nginx layer
# 7. Set short-lived deployment (spin down after assignment)
# 8. Monitor access logs for suspicious activity
