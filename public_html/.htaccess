# Maze Bank — Hostinger/Apache config
#
# PASSWORD PROTECTION
# Do NOT use AuthUserFile here — it requires a server path that differs per
# Hostinger account. Instead, use hPanel > Websites > Security >
# Password Protect Directories to enable HTTP Basic Auth on this folder.
# That generates the correct .htpasswd path automatically.

# Security headers
Header always set X-Robots-Tag "noindex, nofollow"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# SPA routing — send all non-file, non-directory requests to index.html
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
